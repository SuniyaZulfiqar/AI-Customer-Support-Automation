    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT EXISTS (\n    SELECT 1\n    FROM customer_analysis_new\n    WHERE LOWER(TRIM(customer_email)) =\n          LOWER(TRIM('{{ $json.body.customer_email.replace(/'/g, \"''\") }}'))\n\n      AND LOWER(\n            REGEXP_REPLACE(TRIM(message), '[[:punct:]]', '', 'g')\n          ) =\n          LOWER(\n            REGEXP_REPLACE(\n              TRIM('{{ $json.body.message.replace(/'/g, \"''\") }}'),\n              '[[:punct:]]',\n              '',\n              'g'\n            )\n          )\n) AS duplicate;",
        "options": {}
      },
